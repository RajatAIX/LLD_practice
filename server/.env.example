# ─── Server Configuration ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (get from https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lld-practice?retryWrites=true&w=majority

# ─── AI Configuration ──────────────────────────────────────────────────────
# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS ──────────────────────────────────────────────────────────────────
# The exact URL of your deployed frontend (no trailing slash)
ALLOWED_ORIGIN=https://your-frontend-domain.com
